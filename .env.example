# Supabase (valores públicos, seguros para uso no navegador quando o RLS estiver ativo)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_ou_publishable

# Fonte do catálogo: "local" (padrão) ou "supabase".
CATALOG_PROVIDER=local
# Fallback de emergência, somente quando autorizado explicitamente.
CATALOG_FALLBACK=

# Uso exclusivo do script local scripts/import-products.js. Nunca exponha esta
# chave no navegador, em variáveis NEXT_PUBLIC_* ou no repositório.
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_apenas_local

# URL gratuita principal da Vercel. Use a mesma origem cadastrada no Mercado Pago.
NEXT_PUBLIC_SITE_URL=https://bros-store-site.vercel.app

# Mercado Pago: use credenciais TEST-* no ambiente de teste e APP_USR-* somente
# em produção. Nunca use prefixo NEXT_PUBLIC_ no access token ou no segredo.
MERCADO_PAGO_ACCESS_TOKEN=TEST-seu_access_token_de_teste
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-sua_public_key_de_teste
MERCADO_PAGO_WEBHOOK_SECRET=seu_segredo_real_do_webhook
